# .env.example
# Copia este archivo a .env y rellena con tus credenciales reales.
# El .env NUNCA debe commitearse al repositorio (ya está en .gitignore).

# ── Copernicus Data Space Ecosystem (CDSE) ──────────────────
# Registro gratuito en: https://dataspace.copernicus.eu/
CDSE_USER=tu_email@ejemplo.com
CDSE_PASSWORD=tu_contraseña_aqui

# ── Alpha Earth ─────────────────────────────────────────────
# API key de tu cuenta en Alpha Earth
ALPHA_EARTH_API_KEY=tu_api_key_aqui
ALPHA_EARTH_BASE_URL=https://api.alphaearth.ai/v1

# ── Anthropic Claude (multimodal — backend API) ─────────────
# Registro en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── MLflow (opcional, para tracking de experimentos) ────────
MLFLOW_TRACKING_URI=http://localhost:5000
