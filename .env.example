# .env.example
# Copia este archivo a .env y rellena las credenciales necesarias.
# El archivo .env real no debe subirse al repositorio.

# Copernicus Data Space Ecosystem (CDSE)
# Registro gratuito: https://dataspace.copernicus.eu/
CDSE_USER=tu_email@ejemplo.com
CDSE_PASSWORD=tu_contrasena_aqui

# Alpha Earth
ALPHA_EARTH_API_KEY=tu_api_key_aqui
ALPHA_EARTH_BASE_URL=https://api.alphaearth.ai/v1

# LLM local con Ollama/OpenLLaMA (sin API key)
# Primero descarga el modelo seleccionado, por ejemplo:
#   ollama pull openllama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Modelo Ollama seleccionado.
# Deja solo una opcion sin comentar. Para cambiar de modelo:
# 1. Ejecuta: ollama pull <modelo>
# 2. Comenta la opcion actual.
# 3. Descomenta la opcion que quieres usar.
# OLLAMA_MODEL=llama3.2:3b
OLLAMA_MODEL=openllama
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_MODEL=gemma2:2b
# OLLAMA_MODEL=phi3:mini
# OLLAMA_MODEL=llama3.1:8b

# Claude opcional, solo si cambias LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# MLflow (tracking opcional de experimentos)
MLFLOW_TRACKING_URI=http://localhost:5000
